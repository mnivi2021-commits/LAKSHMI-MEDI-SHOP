# =============================================================================
# MARKETING CRM - environment configuration
# Copy to .env and fill in. NEVER commit .env to Git.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="Marketing CRM"
# local | staging | production
APP_ENV=local
# true only on a developer machine - shows error details
APP_DEBUG=true
# Public URL of the web app, no trailing slash
APP_URL=http://localhost/marketing_crm
APP_TIMEZONE=Asia/Kolkata
# 32+ random characters. Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# --- Database (MySQL 8) ------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marketing_crm
DB_USERNAME=crm_app
DB_PASSWORD=

# --- Session / security ------------------------------------------------------
SESSION_NAME=mcrm_session
# Minutes of inactivity before logout
SESSION_LIFETIME=120
# true when served over HTTPS (always true in production)
SESSION_SECURE_COOKIE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- API (mobile app) --------------------------------------------------------
# Comma-separated origins allowed to call /api from a browser (Expo web, admin UI)
API_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
API_TOKEN_TTL_DAYS=30
API_RATE_LIMIT_PER_MINUTE=120

# --- Uploads -----------------------------------------------------------------
UPLOAD_MAX_MB=10

# --- Mail provider (Phase 18) ------------------------------------------------
# manual | imap | gmail | microsoft_graph
MAIL_PROVIDER=manual
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_USERNAME=
MAIL_IMAP_PASSWORD=
MAIL_GMAIL_CLIENT_ID=
MAIL_GMAIL_CLIENT_SECRET=
MAIL_GRAPH_TENANT_ID=
MAIL_GRAPH_CLIENT_ID=
MAIL_GRAPH_CLIENT_SECRET=

# --- SMS gateway (Phase 19) --------------------------------------------------
# mock = never sends real SMS. Change only after a real provider is integrated.
SMS_GATEWAY=mock
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=

# --- Logging -----------------------------------------------------------------
# debug | info | warning | error
LOG_LEVEL=info
